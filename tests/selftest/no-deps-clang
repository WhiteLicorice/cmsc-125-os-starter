#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Self-test fixture: a compiler that compiles but cannot list dependencies.
#
# The self-test sets CC to this wrapper. It rejects only -M, so the build
# succeeds and the dependency scan fails. The controller must stop with the
# diagnostic and report "build-identity".
#
# A real compile goes to the compiler the caller selected, named by
# KTEST_BASE_CC, because the system clang carries no RISC-V target on macOS.
# Split that command the way the controller does: plain words with globbing
# off. The fixture's own arguments stay intact. A quoted command would name
# one program, so the compile would never start.
for arg in "$@"; do
    [ "$arg" != -M ] || exit 1
done
base_cc="${KTEST_BASE_CC:-clang}"
set -f
# shellcheck disable=SC2086
exec $base_cc "$@"
