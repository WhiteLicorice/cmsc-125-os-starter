#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Self-test fixture: a compiler that exits zero and lists no dependencies.
#
# The self-test sets CC to this wrapper. For a dependency scan (-M) it exits 0
# and prints nothing. The build still succeeds, so the identity must fail on
# its own: the controller must never accept an empty dependency list.
#
# A real compile goes to the compiler the caller selected, named by
# KTEST_BASE_CC, because the system clang carries no RISC-V target on macOS.
# Split that command the way the controller does: plain words with globbing
# off. The fixture's own arguments stay intact. A quoted command would name
# one program, so the compile would never start.
for arg in "$@"; do
    [ "$arg" != -M ] || exit 0
done
base_cc="${KTEST_BASE_CC:-clang}"
set -f
# shellcheck disable=SC2086
exec $base_cc "$@"
